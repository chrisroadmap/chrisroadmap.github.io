<li class="repo-list-item" data-github-user="{{ include.username }}">
  <a href="https://github.com/{{ include.username }}">
    <img class="gh-avatar" data-gh-avatar hidden alt="">
    <i class="fa-brands fa-github" data-gh-fallback-icon></i>
    <span class="repo-name">{{ include.username }}</span>
    <span class="repo-meta" data-gh-meta>GitHub profile</span>
  </a>
</li>
